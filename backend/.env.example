APP_NAME=校园百事通 · 高校教务政策 RAG 智能咨询系统
DEBUG=true
API_PREFIX=/api

DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/edu_rag?charset=utf8mb4

MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b


UPLOAD_PATH=data/uploads

# milvus-lite 底层 faiss 不认非 ASCII 路径，含中文的项目目录下索引会写失败，
# 建议指向纯英文目录（如 D:/milvus_data/campus_rag）
MILVUS_PATH=data/milvus

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
ENABLE_RERANKER=true
ENABLE_QUERY_REWRITE=false
WARMUP_ON_STARTUP=true
WARMUP_LLM_ON_STARTUP=false
ENABLE_LLM_JUDGE=false

RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
MIN_EVIDENCE_SCORE=0.25

CORS_ORIGINS=http://localhost:5173